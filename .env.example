POSTGRES_PORT=5434
DB_URL=jdbc:postgresql://127.0.0.1:5434/nexodocs
DB_USERNAME=nexodocs
DB_PASSWORD=cambia_esta_clave
BACKEND_PORT=8080
FRONTEND_PORT=4200
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
FRONTEND_URL=http://localhost:4200
MAIL_FROM=hello@demomailtrap.co
PASSWORD_RECOVERY_EXPIRATION_MINUTES=30
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=api
MAIL_PASSWORD=replace-with-new-mailtrap-token
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
JWT_EXPIRATION_MS=28800000
STORAGE_LOCAL_PATH=./data/storage
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=35
STRIPE_API_KEY=rk_test_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET
# Recurring Price IDs (price_..., not prod_...) from Stripe; leave empty to disable that plan/cycle.
# Real values go in infrastructure/.env, which docker compose reads and git ignores.
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=
