# Limite de intentos de inicio de sesión (por IP y por identificador), ventana fija.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Optional platform queue is enabled only by docker-compose.backup-operator.yml.
# Host systemd services use BACKUP_DESTINATION and BACKUP_QUEUE (see wiki runbook).

# Anclaje externo de la cadena de auditoria (C3). docker-compose lo activa por defecto: publica el ultimo hash
# de cada cadena en un archivo append-only (JSON lines) del volumen nexodocs_audit_anchor, que solo monta el
# backend (el contenedor de PostgreSQL no lo ve). Vaciar la variable desactiva el job (NOT_CONFIGURED).
AUDIT_ANCHOR_EXTERNAL_FILE=/var/lib/nexodocs/audit-anchor/anchors.jsonl
# Destino HTTP opcional (webhook; PUT para URLs prefirmadas, p. ej. S3 con Object Lock). READ_URL permite verificar contra el.
AUDIT_ANCHOR_EXTERNAL_HTTP_URL=
AUDIT_ANCHOR_EXTERNAL_HTTP_READ_URL=
AUDIT_ANCHOR_EXTERNAL_HTTP_METHOD=POST
AUDIT_ANCHOR_EXTERNAL_HTTP_AUTH_HEADER=
AUDIT_ANCHOR_EXTERNAL_HTTP_TIMEOUT_MS=5000
# Cron de Spring (6 campos); por defecto cada 15 minutos. "-" desactiva el programador.
AUDIT_ANCHOR_CRON=0 */15 * * * *
# Clave HMAC de las anclas. Si se deja vacia, el backend genera una aleatoria la primera vez y la guarda en
# AUDIT_ANCHOR_KEY_FILE (fuera de la base de datos). Definirla solo para compartir la clave entre replicas.
AUDIT_ANCHOR_KEY_FILE=/var/lib/nexodocs/audit-anchor/anchor.key
AUDIT_ANCHOR_SECRET=
